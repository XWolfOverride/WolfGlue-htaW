<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="WolfGlue.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>WolfGlue</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Solo se descarga (no se referencia): WolfGlue.targets toma de ahi el loader nativo -->
    <PackageDownload Include="Microsoft.Web.WebView2" Version="[$(WolfGlueWebView2Version)]" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\glue.js" LogicalName="WolfGlue.glue.js" />
    <None Include="WolfGlue.props;WolfGlue.targets;app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WolfGlue.Tests" />
  </ItemGroup>
</Project>
