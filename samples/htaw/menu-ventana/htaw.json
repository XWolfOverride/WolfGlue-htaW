      { "text": "&Herramientas", "items": [ { "id": "h-ortografia", "text": "&Ortografia" }, { "id": "h-opciones", "text": "O&pciones..." } ] },
      { "text": "&Datos", "items": [ { "id": "d-ordenar", "text": "&Ordenar" }, { "id": "d-filtrar", "text": "&Filtrar" } ] },
      { "text": "Ve&ntana", "items": [ { "id": "w-nueva", "text": "&Nueva ventana" }, { "id": "w-cascada", "text": "&Cascada" } ] },
      { "text": "&Complementos", "items": [ { "id": "c-gestionar", "text": "&Gestionar" } ] },
      { "text": "A&yuda", "items": [ { "id": "acerca", "text": "&Acerca de..." } ] }
    ]
  }
