{
  "id": "wolfglue.ejemplo.menuventana",
  "name": "Menu de ventana",
  "version": "1.0.0",
  "entry": "index.html",
  "window": {
    "width": 700, "height": 420, "backdrop": "tinted", "minWidth": 420, "minHeight": 300,
    "menu": [
      { "text": "&Archivo", "items": [
        { "id": "nuevo", "text": "&Nuevo", "shortcut": "Ctrl+N" },
        { "id": "abrir", "text": "&Abrir...", "shortcut": "Ctrl+O" },
        { "type": "separator" },
        { "id": "salir", "text": "&Salir" }
      ] },
      { "text": "&Editar", "items": [
        { "id": "copiar", "text": "&Copiar", "shortcut": "Ctrl+C" },
        { "id": "pegar", "text": "&Pegar", "shortcut": "Ctrl+V", "enabled": false },
        { "text": "Mas", "items": [ { "id": "otro", "text": "Segundo nivel" } ] }
      ] },
      { "text": "&Ver", "items": [
        { "id": "negrita", "text": "Negrita", "checked": true },
